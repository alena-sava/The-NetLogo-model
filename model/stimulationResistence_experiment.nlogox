; =========================================================
; VARIABLES
; =========================================================

turtles-own [
  mecA?
  group
  carrier-type

  ; properties of bacteria
  competent?
  dividing?

  ; properties of mobile genetic carriers
  phage-carries-mecA?
  plasmid-carries-mecA?
  mge-carries-mecA?
]

; Free DNA exists outside bacteria, in the environment
patches-own [
  free-DNA?
]


; =========================================================
; SETUP
; =========================================================

to setup
  clear-all

  
  ; =================================
  ; CSV EXPORT INITIALIZATION
  ; =================================

  file-close-all

  if file-exists? "population_experiment_corrected.csv" [
    file-delete "population_experiment_corrected.csv"
  ]

  file-open "population_experiment_corrected.csv"
  file-print "ticks,resistant_bacteria,susceptible_bacteria,resistant_MGE"
  file-close

  
  
  ; =====================================================
  ; GROUP 0 — INITIAL RESISTANT BACTERIA
  ; 5 bacteria carrying mecA
  ; =====================================================

  create-turtles 5 [
    setxy random-xcor random-ycor

    set group 0
    set carrier-type "none"

    ; Initial resistant bacteria
    set mecA? true

    set competent? false
    set dividing? false

    set phage-carries-mecA? false
    set plasmid-carries-mecA? false
    set mge-carries-mecA? false

    set shape "bug"
    set size 1.5
  ]


  ; =====================================================
  ; GROUP 1 — MOBILE GENETIC CARRIERS
  ; =====================================================

  ; ----- PLASMIDS -----

  create-turtles number-of-bacteria [
    setxy random-xcor random-ycor

    set group 1
    set carrier-type "plasmid"

    set mecA? false
    set competent? false
    set dividing? false

    set phage-carries-mecA? false
    set plasmid-carries-mecA? false
    set mge-carries-mecA? false

    set shape "circle"
    set size 1.0
  ]


  ; ----- BACTERIOPHAGES -----

  create-turtles number-of-bacteria [
    setxy random-xcor random-ycor

    set group 1
    set carrier-type "bacteriophage"

    set mecA? false
    set competent? false
    set dividing? false

    set phage-carries-mecA? false
    set plasmid-carries-mecA? false
    set mge-carries-mecA? false

    set shape "bug"
    set size 1.0
  ]


  ; ----- MOBILE GENETIC ELEMENTS -----

  create-turtles number-of-bacteria [
    setxy random-xcor random-ycor

    set group 1
    set carrier-type "MGE"

    set mecA? false
    set competent? false
    set dividing? false

    set phage-carries-mecA? false
    set plasmid-carries-mecA? false
    set mge-carries-mecA? false

    set shape "star"
    set size 1.0
  ]


  ; =====================================================
  ; GROUP 2 — TRANSFORMATION
  ; Free DNA + bacterial competence
  ; =====================================================

  create-turtles number-of-bacteria [
    setxy random-xcor random-ycor

    set group 2
    set carrier-type "none"

    set mecA? false

    ; Bacterium is competent
    set competent? true

    set dividing? false

    set phage-carries-mecA? false
    set plasmid-carries-mecA? false
    set mge-carries-mecA? false

    set shape "bug"
    set size 1.5
  ]


  ; =====================================================
  ; GROUP 3 — VERTICAL TRANSMISSION
  ; Bacterial division → inheritance of mecA
  ; =====================================================

  create-turtles number-of-bacteria [
    setxy random-xcor random-ycor

    set group 3
    set carrier-type "none"

    set mecA? false

    set competent? false

    ; Initially not dividing
    set dividing? false

    set phage-carries-mecA? false
    set plasmid-carries-mecA? false
    set mge-carries-mecA? false

    set shape "bug"
    set size 1.5
  ]


  ; =====================================================
  ; INITIAL ENVIRONMENT
  ; =====================================================

  ask patches [
    set free-DNA? false
  ]

  reset-ticks
end


; =========================================================
; MOVEMENT
; =========================================================

to move
  right random 150
  left random 150
  fd 0.5
end


; =========================================================
; REPRODUCTION / VERTICAL TRANSMISSION
;
; Only bacteria reproduce.
; mecA is automatically inherited by the daughter cell
; because hatch copies the parent's variables.
; =========================================================

to reproduce

  ; Group 1 = mobile carriers, so they do not reproduce
  if group != 1 [

    if count turtles < 1000 [

      if random-float 1 < reproduction-probability [

        set dividing? true

        hatch 1 [
          rt random 360
          fd 1

          ; mecA? is inherited automatically
          ; from the parent by hatch

          set dividing? false
        ]

        set dividing? false
      ]
    ]
  ]
end


; =========================================================
; MOBILE GENETIC CARRIERS
;
; Plasmid / bacteriophage / MGE can acquire mecA from
; a resistant bacterium and subsequently transfer it
; to a susceptible bacterium.
; =========================================================

to mobile-transfer

  ; Only Group 1 objects participate here
  if group = 1 [

    ; -----------------------------------------------
    ; STEP 1 — carrier acquires mecA
    ; -----------------------------------------------

    if carrier-type = "plasmid" [
      if not plasmid-carries-mecA? [

        if any? turtles-here with [
          group != 1 and mecA?
        ] [

          if random-float 1 < mecA-transfer-probability [
            set plasmid-carries-mecA? true
          ]
        ]
      ]
    ]


    if carrier-type = "bacteriophage" [
      if not phage-carries-mecA? [

        if any? turtles-here with [
          group != 1 and mecA?
        ] [

          if random-float 1 < mecA-transfer-probability [
            set phage-carries-mecA? true
          ]
        ]
      ]
    ]


    if carrier-type = "MGE" [
      if not mge-carries-mecA? [

        if any? turtles-here with [
          group != 1 and mecA?
        ] [

          if random-float 1 < mecA-transfer-probability [
            set mge-carries-mecA? true
          ]
        ]
      ]
    ]


    ; -----------------------------------------------
    ; STEP 2 — carrier transfers mecA to bacterium
    ; -----------------------------------------------

    if carrier-type = "plasmid" [
      if plasmid-carries-mecA? [

        let target one-of other turtles-here with [
          group != 1 and not mecA?
        ]

        if target != nobody [
          if random-float 1 < mecA-transfer-probability [
            ask target [
              set mecA? true
            ]
          ]
        ]
      ]
    ]


    if carrier-type = "bacteriophage" [
      if phage-carries-mecA? [

        let target one-of other turtles-here with [
          group != 1 and not mecA?
        ]

        if target != nobody [
          if random-float 1 < mecA-transfer-probability [
            ask target [
              set mecA? true
            ]
          ]
        ]
      ]
    ]


    if carrier-type = "MGE" [
      if mge-carries-mecA? [

        let target one-of other turtles-here with [
          group != 1 and not mecA?
        ]

        if target != nobody [
          if random-float 1 < mecA-transfer-probability [
            ask target [
              set mecA? true
            ]
          ]
        ]
      ]
    ]
  ]
end


; =========================================================
; TRANSFORMATION
;
; mecA+ bacteria release free DNA.
; Competent bacteria can take up this DNA.
; =========================================================

to transformation

  ; -----------------------------------------------
  ; STEP 1 — mecA+ bacteria release free DNA
  ; -----------------------------------------------

  ask turtles with [
    group != 1 and mecA?
  ] [

    if random-float 1 < mecA-transfer-probability [

      ask patch-here [
        set free-DNA? true
      ]
    ]
  ]


  ; -----------------------------------------------
  ; STEP 2 — competent bacteria take up free DNA
  ; -----------------------------------------------

  ask turtles with [
    group = 2 and competent? and not mecA?
  ] [

    if [free-DNA?] of patch-here [

      if random-float 1 < mecA-transfer-probability [
        set mecA? true

        ; DNA is consumed
        ask patch-here [
          set free-DNA? false
        ]
      ]
    ]
  ]
end


; =========================================================
; MAIN LOOP
; =========================================================


to go

  ; =================================
  ; 1. MOVEMENT
  ; =================================

  ask turtles [
    move
  ]

  ; =================================
  ; 2. BACTERIAL REPRODUCTION
  ;    Vertical transmission of mecA
  ; =================================

  ask turtles [
    reproduce
  ]

  ; =================================
  ; 3. MOBILE CARRIERS
  ;    HORIZONTAL TRANSFER ENABLED
  ; =================================

  ask turtles [
    mobile-transfer
  ]

  ; =================================
  ; 4. TRANSFORMATION
  ;    HORIZONTAL TRANSFER ENABLED
  ; =================================

  transformation

  ; =================================
  ; 5. UPDATE COLOURS
  ; =================================

  ask turtles [
    recolor
  ]

  ; =================================
  ; 6. ADVANCE SIMULATION TIME
  ;    One tick per go cycle
  ; =================================

  tick

  ; =================================
  ; 7. CALCULATE POPULATION COUNTS
  ; =================================

  ; Count all bacteria (groups 0, 2 and 3),
  ; excluding mobile genetic carriers (group 1).

  let resistant-count count turtles with [
    group != 1 and mecA?
  ]

  let susceptible-count count turtles with [
    group != 1 and not mecA?
  ]

  let resistant-mge-count count turtles with [
    group = 1 and (
      plasmid-carries-mecA?
      or phage-carries-mecA?
      or mge-carries-mecA?
    )
  ]

  ; =================================
  ; 8. UPDATE POPULATION DYNAMICS PLOT
  ; =================================

  set-current-plot "Population dynamics"

  set-current-plot-pen "resistant-bacteria"
  plot resistant-count

  set-current-plot-pen "susceptible-bacteria"
  plot susceptible-count

  set-current-plot-pen "resistant-MGE"
  plot resistant-mge-count

  ; =================================
  ; 9. EXPORT ONE ROW PER TICK
  ; =================================

  file-open "population_experiment_corrected.csv"

  file-print (word ticks ","
    resistant-count ","
    susceptible-count ","
    resistant-mge-count)

  file-close

  ; =================================
  ; 10. STOP AT 700 TICKS
  ; =================================

  if ticks >= 700 [
    stop
  ]

end



; =========================================================
; COLOUR
; =========================================================

to recolor

  if group = 1 [

    ; Mobile carriers carrying mecA are red
    if carrier-type = "plasmid" [
      ifelse plasmid-carries-mecA?
      [ set color red ]
      [ set color green ]
    ]

    if carrier-type = "bacteriophage" [
      ifelse phage-carries-mecA?
      [ set color red ]
      [ set color green ]
    ]

    if carrier-type = "MGE" [
      ifelse mge-carries-mecA?
      [ set color red ]
      [ set color green ]
    ]
  ]

  ; Bacteria
  if group != 1 [
    ifelse mecA?
    [ set color red ]
    [ set color blue ]
  ]

end
